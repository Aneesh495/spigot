#!/usr/bin/env bash
# Spigot CLI launcher
# Dispatches assay execution, verification, and interactive inspection to the Squirrel runtime.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

SQ_BIN="${SQ_BIN:-$(which sq 2>/dev/null || true)}"

if [[ -z "${SQ_BIN}" ]]; then
    echo "Error: Squirrel interpreter 'sq' not found in PATH." >&2
    echo "Please install Squirrel 3.2 (e.g. via 'brew install squirrel-lang')." >&2
    exit 1
fi

export SPIGOT_ROOT="${PROJECT_ROOT}"

if [[ $# -eq 0 ]]; then
    exec "${SQ_BIN}" "${PROJECT_ROOT}/ui/cli_app.nut" --help
else
    exec "${SQ_BIN}" "${PROJECT_ROOT}/ui/cli_app.nut" "$@"
fi
