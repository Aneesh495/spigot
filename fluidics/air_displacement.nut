// Spigot Air-Cushion Displacement and Compressibility Model
// Solves Boyle's law isothermal expansion and equilibration lag for air-displacement pipetting.

dofile("core/units.nut");

class AirDisplacementModel {
    // Computes air cushion isothermal expansion volume (uL) under differential pressure:
    // P0 * V0 = (P0 - DeltaP) * (V0 + DeltaV) => DeltaV = V0 * (DeltaP / (P0 - DeltaP))
    static function calculate_air_expansion_ul(air_cushion_ul, differential_pressure_mbar) {
        local p0 = ATMOSPHERIC_PRESSURE_MBAR;
        local dp = differential_pressure_mbar.tofloat();
        if (dp >= p0) dp = p0 * 0.99; // Cap to avoid negative pressure singularity

        local v0 = air_cushion_ul.tofloat();
        local delta_v = v0 * (dp / (p0 - dp));
        return delta_v;
    }

    // Computes hydrostatic backpressure (mbar) generated by the liquid column inside the tip:
    // DeltaP_hydro = rho * g * h_liquid
    static function calculate_hydrostatic_head_mbar(liquid_height_mm, density_kg_m3) {
        local h_m = mm_to_m(liquid_height_mm);
        local p_pa = density_kg_m3 * GRAVITY_M_S2 * h_m;
        return pa_to_mbar(p_pa);
    }

    // Computes dynamic aspiration volume lag at time t given piston displacement and viscous time constant tau:
    // V_actual(t) = V_commanded * (1 - exp(-t / tau))
    static function calculate_aspiration_response(commanded_ul, time_elapsed_s, time_constant_s) {
        if (time_constant_s <= 0.0) return commanded_ul;
        local ratio = time_elapsed_s / time_constant_s;
        return commanded_ul * (1.0 - exp(-ratio));
    }
}
